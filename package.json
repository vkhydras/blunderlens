{
  "name": "chess-analyzer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "start": "npm run build && node --disable-warning=ExperimentalWarning server/index.js",
    "build:web": "node scripts/copy-stockfish.js && vite build --config vite.web.config.js --outDir dist-web",
    "preview:web": "vite preview --config vite.web.config.js --outDir dist-web --port 5175"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "stockfish": "^19.0.1",
    "vite": "^8.3.5"
  }
}
